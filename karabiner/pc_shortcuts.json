{
	"title": "PC shortcuts",
	"rules": [
		{
			"description": "Ctrl+A select all (except terminals)",
			"manipulators": [
				{
					"type": "basic",
					"from": {
						"key_code": "q", // a in azerty
						"modifiers": {
							"mandatory": ["control"],
							"optional": ["any"]
						}
					},
					"to": [
						{
							"key_code": "q", // a in azerty
							"modifiers": ["command"]
						}
					],
					"conditions": [
						{
							"type": "frontmost_application_unless",
							"bundle_identifiers": [
								"^com\\.apple\\.Terminal$",
								"^com\\.googlecode\\.iterm2$",
								"^com\\.microsoft\\.VSCode$",
								"^net\\.kovidgoyal\\.kitty$"
							]
						}
					]
				}
			]
		},
		{
			"description": "Ctrl+C copy (except terminals so SIGINT works)",
			"manipulators": [
				{
					"type": "basic",
					"from": {
						"key_code": "c",
						"modifiers": {
							"mandatory": ["control"],
							"optional": ["any"]
						}
					},
					"to": [
						{
							"key_code": "c",
							"modifiers": ["command"]
						}
					],
					"conditions": [
						{
							"type": "frontmost_application_unless",
							"bundle_identifiers": [
								"^com\\.apple\\.Terminal$",
								"^com\\.googlecode\\.iterm2$",
								"^com\\.microsoft\\.VSCode$",
								"^net\\.kovidgoyal\\.kitty$"
							]
						}
					]
				}
			]
		},
        {
            "description": "Ctrl+W delete previous word (except terminals)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "q", // w in azerty
                        "modifiers": {
                            "mandatory": ["control"],
                            "optional": ["any"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "delete_or_backspace",
                            "modifiers": ["option"]
                        }
                    ],
                    "conditions": [
                        {
                            "type": "frontmost_application_unless",
                            "bundle_identifiers": [
                                "^com\\.apple\\.Terminal$",
                                "^com\\.googlecode\\.iterm2$",
                                "^net\\.kovidgoyal\\.kitty$"
                            ]
                        }
                    ]
                }
            ]
        },
		{
			"description": "Ctrl+Shift+V paste (Linux-style)",
			"manipulators": [
				{
					"type": "basic",
					"from": {
						"key_code": "v",
						"modifiers": {
							"mandatory": ["control", "shift"],
							"optional": ["any"]
						}
					},
					"to": [
						{
							"key_code": "v",
							"modifiers": ["command"]
						}
					]
				}
			]
		},
		{
			"description": "Ctrl+V paste",
			"manipulators": [
				{
					"type": "basic",
					"from": {
						"key_code": "v",
						"modifiers": {
							"mandatory": ["control"],
							"optional": ["any"]
						}
					},
					"to": [
						{
							"key_code": "v",
							"modifiers": ["command"]
						}
					]
				}
			]
		},
		{
			"description": "Ctrl+X cut",
			"manipulators": [
				{
					"type": "basic",
					"from": {
						"key_code": "x",
						"modifiers": {
							"mandatory": ["control"],
							"optional": ["any"]
						}
					},
					"to": [
						{
							"key_code": "x",
							"modifiers": ["command"]
						}
					]
				}
			]
		},
		{
			"description": "Ctrl+Z undo",
			"manipulators": [
				{
					"type": "basic",
					"from": {
						"key_code": "w", // z in azerty
						"modifiers": {
							"mandatory": ["control"],
							"optional": ["any"]
						}
					},
					"to": [
						{
							"key_code": "w", // z in azerty
							"modifiers": ["command"]
						}
					]
				}
			]
		},
		{
			"description": "Alt+Tab -> Cmd+Tab",
			"manipulators": [
				{
					"type": "basic",
					"from": {
						"key_code": "tab",
						"modifiers": {
							"mandatory": ["option"],
							"optional": ["any"]
						}
					},
					"to": [
						{
							"key_code": "tab",
							"modifiers": ["command"]
						}
					]
				}
			]
		},
        {
            "description": "Ctrl+T new tab (except terminals)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "t",
                        "modifiers": {
                            "mandatory": ["control"],
                            "optional": ["any"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "t",
                            "modifiers": ["command"]
                        }
                    ],
                    "conditions": [
                        {
                            "type": "frontmost_application_unless",
                            "bundle_identifiers": [
                                "^com\\.apple\\.Terminal$",
                                "^com\\.googlecode\\.iterm2$",
                                "^com\\.microsoft\\.VSCode$",
                                "^net\\.kovidgoyal\\.kitty$"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "description": "Ctrl+E open Finder",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "e",
                        "modifiers": {
                            "mandatory": ["control"],
                            "optional": ["any"]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -a Finder"
                        }
                    ],
                    "conditions": [
                        {
                            "type": "frontmost_application_unless",
                            "bundle_identifiers": [
                                "^com\\.apple\\.Terminal$",
                                "^com\\.googlecode\\.iterm2$",
                                "^net\\.kovidgoyal\\.kitty$"
                            ]
                        }
                    ]
                }
            ]
        }
	]
}
